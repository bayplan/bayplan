# Template for the development cluster that `make dev` (scripts/dev.sh)
# registers when it brings the environment up, so that it does not have to be
# added by hand in /admin/clusters every time the database is recreated.
#
#   cp .cluster.dev.env.example .cluster.dev.env   # gitignored, never commit it
#
# 1. Apply the panel's RBAC to the test cluster:
#      kubectl apply -f deploy/rbac/serviceaccount.yaml
# 2. Get a token for the technical ServiceAccount:
#      kubectl -n kube-system create token bayplan-technical --duration=720h
# 3. Save the cluster's CA (base64-decoded PEM) to .cluster.dev.ca.pem (also
#    gitignored), or point CLUSTER_CA_FILE at it:
#      kubectl config view --raw --minify -o jsonpath='{.clusters[0].cluster.certificate-authority-data}' | base64 -d > .cluster.dev.ca.pem
#
# While the token keeps the placeholder below, the registration is skipped.

CLUSTER_DISPLAY_NAME="dev"
CLUSTER_API_ENDPOINT="https://127.0.0.1:6443"
CLUSTER_SA_TOKEN="PASTE_TOKEN_HERE"
# CLUSTER_CA_FILE=".cluster.dev.ca.pem"
