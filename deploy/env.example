# Backend ENVIRONMENT variables. Only the irreducible bootstrap lives here; everything
# else (public URL, SSO/OIDC, clusters) is configured from the UI under Settings and
# stored in the database.
#
# Copy this file to bayplan.env (outside the repo) and fill it in. Secrets (DB
# password, encryption key) can go here or, better, as Podman secrets injected into
# the .container unit (see bayplan.container).

# Postgres. The password goes INSIDE the URL: the binary reads no other variable to
# compose it. Empty = all-in-one mode: the PostgreSQL shipped in the image runs
# inside the container with its data under DATA_DIR (see deploy/README.md).
DATABASE_URL=postgres://bayplan:CHANGEME@bayplan-db:5432/bayplan?sslmode=disable
# DATA_DIR=/data

# Credential encryption (cluster tokens, OIDC client secret). AES-256 key in base64
# (openssl rand -base64 32). ACTIVE_ID selects which key encrypts new data; old keys
# (ENCRYPTION_KEY_V1, _V2…) can be kept to keep decrypting after a rotation. Store a
# copy of the key SEPARATELY from the database backup.
ENCRYPTION_KEY_ACTIVE_ID=v1
ENCRYPTION_KEY_V1=

# HTTP
LISTEN_ADDR=:8080
# Networks of the TLS reverse proxy from which X-Forwarded-For is trusted (CIDR or IP,
# comma-separated). Empty = the header is ignored and audit/rate limiting see the
# proxy's IP. Put ONLY the proxy's address or network here: any client inside a
# trusted range can forge X-Forwarded-For (audit IP, login rate-limit key).
# The example is Podman's default range for user networks (10.89.0.0/16);
# Docker/Compose networks usually fall in 172.16.0.0/12 instead. Check yours
# with `podman network inspect` / `docker network inspect`.
TRUSTED_PROXIES=10.89.0.0/16
# Secure cookies (true in production). With true the browser only sends the
# session cookie over HTTPS: opening the panel over plain http:// (no proxy, no
# built-in HTTPS) makes login silently fail. Set false only for a plain-HTTP test.
COOKIE_SECURE=true

# HTTPS served by the binary itself, without a proxy in front (on by default in
# all-in-one mode). Certificate: your files, Let's Encrypt, or neither = a
# private CA kept in DATA_DIR/tls. With HTTPS on, LISTEN_ADDR only redirects.
# TLS_LISTEN_ADDR=:8443
# TLS_CERT_FILE=/etc/bayplan/tls.crt
# TLS_KEY_FILE=/etc/bayplan/tls.key
# ACME_DOMAINS=bayplan.example.com
# ACME_EMAIL=ops@example.com

# Initial admin password for unattended installs (12+ characters, only used on
# the first start, must be changed on first login). Empty = one-time setup
# token in the log.
# BOOTSTRAP_PASSWORD=

# Sessions
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h

LOG_LEVEL=info

# INITIAL values for Settings → Server (applied only when empty in the DB; afterwards
# whatever the admin edits wins). They let a deployment leave the instance ready
# without going through the UI. Leave AGENT_IMAGE empty to use the official agent
# image of this server's version.
PUBLIC_URL=https://bayplan.example.com
AGENT_IMAGE=

# Legacy (earlier deployments): if all four are set, the SSO is migrated ONCE into
# Settings at startup and they can be removed afterwards. New installations configure
# SSO from the UI and do not need them.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_REDIRECT_URI=
